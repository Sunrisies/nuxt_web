# 只在 Nuxt 服务端使用，浏览器统一访问同源 /api。
NUXT_API_BASE=https://api.sunrise1024.top/api
NUXT_API_TIMEOUT=8000
NUXT_PUBLIC_SITE_URL=https://sunrise1024.top

# 可选：仅本地开发遇到 TUN/fake-IP 路由问题时使用。
# 不需要时不设置；部署到其他机器时不要复制网卡名或固定 IP。
# 域名和 TLS 证书校验仍然保留，IP 应从可信 DNS 查询获得。
# NUXT_API_RESOLVE_ADDRESS=服务器真实IP
# NUXT_API_NETWORK_INTERFACE=en0
